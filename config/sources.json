        "OAI-PMH",
        "DOI content negotiation",
        "DataCite REST for cross-source discovery"
      ],
      "connector": "medatlas.connectors.PANGAEAConnector",
      "realms": [
        "marine",
        "terrestrial",
        "lake",
        "river",
        "atmosphere",
        "ice"
      ],
      "access": "metadata_and_open_data_by_dataset_license",
      "status": "connector_implemented_read_only",
      "limits": [
        "no separate public search API documented; do not depend on internal search endpoints",
        "individual dataset license governs reuse"
      ],
      "numeric_v1": {
        "records": 10,
        "curation": "docs/curation/",
        "release": "atlas-v1-2026-10-28-r2"
      }
    },
    {
      "id": "noaa_wds_paleo",
