{
  "schema_version": "1.0",
  "policy": {
    "read_only_connectors": true,
    "preserve_source_payloads": true,
    "download_measurements_only_on_explicit_request": true,
    "deduplicate_by_doi_and_source_record_id": true,
    "license_unknown_blocks_redistribution": true,
    "geographic_scope_is_configured_not_hard_coded": true
  },
  "sources": [
    {
