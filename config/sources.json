        "public JSON metadata search",
        "paged study search",
        "data file preview/download endpoints"
      ],
      "connector": "medatlas.connectors.NOAAWDSConnector",
      "realms": [
        "marine",
        "terrestrial",
        "lake",
        "tree_ring",
        "ice",
        "speleothem",
        "coral"
      ],
      "access": "metadata_search_and_source_dependent_download",
      "status": "connector_implemented_read_only",
      "limits": [
        "maximum ten full study results per response; follow returned next page",
        "publisher and third-party download restrictions must be honored"
      ],
      "numeric_v1": {
        "records": 3,
        "curation": "docs/curation/",
        "release": "atlas-v1-2026-10-28-r2"
      }
    },
    {
      "id": "neotoma",
      "name": "Neotoma Paleoecology Database",
      "url": "https://www.neotomadb.org/",
